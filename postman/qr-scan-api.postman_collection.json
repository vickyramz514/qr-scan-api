            "url": "{{baseUrl}}/api/v1/scans"
          },
          "status": "Bad Request",
          "code": 400,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"This code already exists\",\n    \"details\": [\n      {\n        \"path\": \"code\",\n        \"message\": \"This code already exists\"\n      }\n    ]\n  }\n}"
        }
      ]
    },
    {
      "name": "Clear scans",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/scans",
        "description": "Deletes every row in the scan table. Devices stay registered."
      },
      "response": [
        {
          "name": "200 Scans cleared",
          "originalRequest": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/scans"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"deleted\": 2\n  }\n}"
        }
      ]
    },
