        }
      ]
    },
    {
      "name": "Submit the same code again",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"code\": \"ABC123456\",\n  \"type\": \"QR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/scans",
        "description": "A code that is already in the scan table is rejected."
      },
      "response": [
        {
          "name": "400 Code already exists",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"code\": \"ABC123456\",\n  \"type\": \"QR\"\n}"
