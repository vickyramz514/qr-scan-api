{
  "info": {
    "name": "QR Scan API",
    "description": "Import this collection, start the API with npm run dev, then run the requests from top to bottom. Submit QR scan saves the new scan id into {{scanId}} for Get scan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "deviceId",
      "value": "8f3a7c2e-91b4-4e2a-9f31"
    },
    {
      "key": "scanId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "response": [
        {
          "name": "200 Server is healthy",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/health"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"message\": \"Server is healthy\"\n}"
        }
      ]
    },
    {
      "name": "Register device",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"android\",\n  \"appVersion\": \"1.0.0\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/devices"
      },
      "response": [
        {
          "name": "200 Device registered",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"android\",\n  \"appVersion\": \"1.0.0\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/devices"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"deviceId\": \"8f3a7c2e-91b4-4e2a-9f31\",\n    \"platform\": \"android\",\n    \"appVersion\": \"1.0.0\",\n    \"createdAt\": \"2026-10-08T10:00:00.000Z\",\n    \"lastSeenAt\": \"2026-10-08T10:00:00.000Z\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Register device again",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"ios\",\n  \"appVersion\": \"1.1.0\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/devices",
        "description": "Same deviceId updates platform, appVersion, and lastSeenAt. It does not create a second device."
      },
      "response": [
        {
          "name": "200 Device updated",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"ios\",\n  \"appVersion\": \"1.1.0\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/devices"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"deviceId\": \"8f3a7c2e-91b4-4e2a-9f31\",\n    \"platform\": \"ios\",\n    \"appVersion\": \"1.1.0\",\n    \"createdAt\": \"2026-10-08T10:00:00.000Z\",\n    \"lastSeenAt\": \"2026-10-08T10:05:00.000Z\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Submit QR scan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.id) {",
              "  pm.collectionVariables.set('scanId', body.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"code\": \"ABC123456\",\n  \"type\": \"QR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/scans"
      },
      "response": [
        {
          "name": "201 QR scan stored",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"code\": \"ABC123456\",\n  \"type\": \"QR\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/scans"
          },
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n    \"deviceId\": \"8f3a7c2e-91b4-4e2a-9f31\",\n    \"code\": \"ABC123456\",\n    \"type\": \"QR\",\n    \"status\": \"RECEIVED\",\n    \"createdAt\": \"2026-10-08T10:01:01.000Z\"\n  }\n}"
        }
      ]
    },
